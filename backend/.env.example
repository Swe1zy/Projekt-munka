# Minta a backend/.env fájlhoz – másold le .env néven, és töltsd ki.
PORT=3600
MONGO_DB=mongodb+srv://felhasznalo:jelszo@cluster.example.mongodb.net/adatbazis
FRONTEND_URL=http://localhost:5173
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CLOUDINARY_API_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin felhasználó (induláskor jön létre / frissül)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
AUTH_TOKEN_SECRET=

# E-mail küldés (SMTP). Ha az SMTP_HOST üres, a levelek a backend/kimeno-levelek
# mappába kerülnek .eml fájlként (fejlesztéshez).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Feladó, pl. "Tüzép" <noreply@tuzep.hu>
EMAIL_FELADO=
# Ide érkeznek az új rendelések és a készletriasztások (alapból a telephely e-mail-címe)
BOLT_ERTESITESI_EMAIL=
