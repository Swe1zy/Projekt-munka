<!DOCTYPE html>
<html lang="hu">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />
        <link
            rel="stylesheet"
            href="/css/termek/new-termek.css"
        />
        <title>Új termek felvétele</title>
    </head>
    <body class="page-new-termek">
        <%- include('../nav.ejs') %>
        <div id="new-termek-container">
            <h1>Új termek felvétele</h1>
            <form class="termek-form">
                <label for="nev">Név:</label>
                <input type="text" id="nev" />

                <label for="kategoria">Kategória:</label>
                <select id="kategoria" required>
                    <option value="" selected disabled>Válassz kategóriát</option>
                    <option value="Falazóanyagok">Falazóanyagok</option>
                    <option value="Cement és kötőanyagok">Cement és kötőanyagok</option>
                    <option value="Faanyagok">Faanyagok</option>
                    <option value="Tetőfedés">Tetőfedés</option>
                    <option value="Hőszigetelés">Hőszigetelés</option>
                    <option value="Szerszámok és kellékek">Szerszámok és kellékek</option>
                </select>

                <label for="leiras">Leírás:</label>
                <textarea id="leiras" rows="10"></textarea>

                <div class="kepmezok-fejlec">
                    <label>Képek:</label>
                    <button type="button" id="kep-hozzaad">Új kép hozzáadása</button>
                </div>

                <div id="kepek-inputok">
                    <div class="kep-mezo">
                        <input type="text" class="kep-input" placeholder="Kép URL-je (vagy válassz fájlt)" />
                        <input type="file" class="kep-fajl" accept="image/*" aria-label="Kép kiválasztása" />
                        <button type="button" class="kep-eltavolit" aria-label="Képmező eltávolítása">Eltávolít</button>
                    </div>
                </div>
                <div class="ar">
                    <label>Ár:</label>
                    <input type="number" id="ar" step="0.01" />
                </div>

                <button type="button" id="feltolt">Feltölt</button>
            </form>
        </div>
        <script src="/js/termek/termek-feltolt.js"></script>
    </body>
</html>
